---
import Icon from '../Icon.astro';
import { URLS } from '../../config';

const heads = ['alex-laptop', 'priya-mbp', 'sam-desktop'];
---

<section id="teams" class="teams-section" aria-labelledby="teams-title">
  <div class="container">
    <div class="band">
      <div class="band__copy">
        <p class="band__eyebrow">For engineering teams</p>
        <h2 id="teams-title" class="h2">Central Fleet: an IT-run farm for overflow.</h2>
        <p class="band__body">
          Each developer's farm handles what it can. When nothing local can take a job, it spills over to a fleet your IT
          team runs, through a Remote Dispatch key they can revoke at any time.
        </p>
        <div class="btn-row">
          <a class="btn btn--dark" href={URLS.sales}>Talk to us</a>
          <a class="btn btn--ink-outline" href={URLS.adminGuide}>Read the admin guide</a>
        </div>
      </div>

      <div class="diagram" role="img" aria-label="Three developers' local farms send overflow jobs down to one IT-run Central Fleet through Remote Dispatch.">
        <div class="heads" aria-hidden="true">
          {
            heads.map((h) => (
              <div class="head">
                <span class="head__label">LOCAL HEAD</span>
                <span class="head__name">{h}</span>
              </div>
            ))
          }
        </div>
        <span class="arrow" aria-hidden="true"><Icon name="arrowDown" size={28} /></span>
        <div class="fleet" aria-hidden="true">
          <span>
            <span class="fleet__name">Central Fleet</span>
            <span class="fleet__sub">IT-run node pool</span>
          </span>
          <span class="fleet__pill">Remote Dispatch</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .teams-section {
    padding: clamp(72px, 10vw, var(--section-pad)) 0;
    border-top: 1px solid var(--site-rule);
  }

  .band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 48px;
    padding: clamp(28px, 5vw, 64px);
    border-radius: 24px;
    background: var(--gold);
    color: var(--on-gold);
  }

  .band > * {
    flex: 1 1 360px;
    min-width: 0;
  }

  .band__copy {
    display: grid;
    gap: 18px;
  }

  .band__eyebrow {
    font: 500 13px/1.4 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .h2 {
    color: var(--on-gold);
  }

  .band__body {
    font-size: 18px;
    line-height: 1.6;
  }

  .btn--dark {
    background: var(--on-gold);
    color: var(--gold);
  }

  .btn--dark:hover {
    background: #3a2c0c;
  }

  .btn--ink-outline {
    border-color: rgba(36, 26, 5, 0.45);
    color: var(--on-gold);
  }

  .btn--ink-outline:hover {
    border-color: var(--on-gold);
  }

  .band :focus-visible {
    outline-color: var(--on-gold);
  }

  .diagram {
    display: grid;
    justify-items: center;
    gap: 12px;
  }

  .heads {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  .head {
    display: grid;
    gap: 4px;
    padding: 14px 12px;
    border-radius: 12px;
    background: #fff8e4;
    border: 1px solid rgba(36, 26, 5, 0.18);
    text-align: center;
  }

  .head__label {
    font: 500 10px/1.3 var(--font-mono);
    letter-spacing: 0.08em;
    color: #5c4712;
  }

  .head__name {
    font: 500 13px/1.3 var(--font-mono);
    overflow-wrap: anywhere;
  }

  .arrow {
    color: var(--on-gold);
  }

  .fleet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    width: 100%;
    padding: 18px 20px;
    border-radius: 14px;
    background: var(--on-gold);
    color: #fff8e4;
  }

  .fleet__name {
    display: block;
    font: 700 22px/1.2 var(--font-display);
    letter-spacing: -0.02em;
  }

  .fleet__sub {
    display: block;
    font: 400 13px/1.4 var(--font-mono);
    color: #e0cfa0;
  }

  .fleet__pill {
    padding: 6px 12px;
    border-radius: 999px;
    background: var(--gold);
    color: var(--on-gold);
    font: 500 12px/1.2 var(--font-mono);
  }
</style>
