---
// toolvalue/ToolValueScreen.kt: the period picker, then one ledger card per agent, best net first.
import data from '../../data/sample.json';

const tv = data.toolValue;
const label = `Llama Farm tool value, ${tv.selected}: ${tv.agents.map((a) => `${a.name} ${a.summary.replace(' · ', ', ')}`).join('; ')}. Every tool's savings are set against what carrying it cost.`;
const columns = ['Calls', 'Saved', 'Results', 'Carrying', 'Net'];
---

<div class="shot tool-value" role="img" aria-label={label}>
  <div class="frame" aria-hidden="true">
    <div class="head">
      <p class="page-title">Tool value</p>
      <p class="lead">
        What each farm tool saved your agents, against what carrying it cost them. Values are input-token equivalents:
        tokens at each model's base input price.
      </p>
    </div>

    <div class="segments">
      {tv.periods.map((p) => <span class:list={['segment', { 'segment--on': p === tv.selected }]}>{p}</span>)}
    </div>

    {
      tv.agents.map((agent) => (
        <div class="card">
          <div class="card__head">
            <p class="card-title">{agent.name}</p>
            <span class="summary">{agent.summary}</span>
          </div>
          <div class="table-scroll">
            <div class="table">
              <div class="tr th">
                <span>TOOL</span>
                {columns.map((col) => <span class="r">{col.toUpperCase()}</span>)}
              </div>
              {agent.rows.map((row) => (
                <div class="tr row">
                  <span class="tool">{row.tool}</span>
                  <span class="num t-2">{row.calls}</span>
                  <span class="num">{row.saved}</span>
                  <span class="num t-2">{row.results}</span>
                  <span class="num t-2">{row.carrying}</span>
                  <span class:list={['num', row.net.startsWith('-') ? 'neg' : 'pos']}>{row.net}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }

    <p class="footnote">
      ~ marks a saving that's partly estimated: searches, and answers the farm wrote in the agent's place. Results are
      what the agent kept in context that no saving covered. Carrying is the tool's definition in every prompt that had
      it.
    </p>
  </div>
</div>

<style>
  .tool-value {
    color: var(--app-text);
    font-family: var(--font-sans);
    text-align: left;
    min-width: 0;
  }

  .frame {
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: 24px;
    background: var(--app-bg);
    border: 1px solid var(--site-border-strong);
    border-radius: 14px;
  }

  .head {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .page-title {
    font-size: 30px;
    line-height: 36px;
    font-weight: 600;
  }

  .lead {
    font-size: 14px;
    line-height: 20px;
    color: var(--app-text2);
  }

  /* SegmentedChoice.kt */
  .segments {
    display: flex;
    align-self: flex-start;
    padding: 3px;
    border-radius: 10px;
    background: var(--app-surface3);
  }

  .segment {
    display: grid;
    place-items: center;
    min-height: 38px;
    padding: 0 14px;
    border-radius: 8px;
    font-size: 13px;
    line-height: 18px;
    white-space: nowrap;
  }

  .segment--on {
    background: var(--app-surface);
  }

  /* ToolValueTable.kt */
  .card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 16px 18px;
    background: var(--app-surface);
    border: 1px solid var(--app-border);
    border-radius: 12px;
  }

  .card__head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding-bottom: 8px;
  }

  .card-title {
    flex: 1;
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
  }

  .summary {
    font-size: 13px;
    line-height: 18px;
    color: var(--app-text2);
  }

  .table-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .table {
    min-width: 440px;
  }

  .tr {
    display: grid;
    grid-template-columns: 2.4fr repeat(5, 1fr);
    gap: 12px;
    align-items: center;
  }

  .th {
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--app-text3);
  }

  .row {
    padding: 8px 0;
  }

  .row + .row {
    border-top: 1px solid var(--app-rule);
  }

  .r,
  .num {
    text-align: right;
  }

  .tool {
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .num {
    font: 400 13px/18px var(--font-mono);
    white-space: nowrap;
  }

  .t-2 {
    color: var(--app-text2);
  }

  .pos {
    color: var(--app-green-text);
  }

  .neg {
    color: var(--app-orange-soft-fg);
  }

  .footnote {
    font-size: 13px;
    line-height: 18px;
    color: var(--app-text3);
  }
</style>
