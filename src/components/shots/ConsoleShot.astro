---
// presenters/dashboard/AgentNodeConsoleScreen.kt in a macOS window. Its breakpoints follow
// the app's BoxWithConstraints checks, as container queries on the window's width.
import Lloyd from '../Lloyd.astro';
import LloydDialog from '../LloydDialog.astro';
import data from '../../data/sample.json';

const c = data.console;
const totalRequests = c.share.reduce((sum, s) => sum + s.count, 0);
const activeNodes = c.statTiles.find((t) => t.label === 'Active nodes')!.value;
const tokensSaved = c.statTiles.find((t) => t.label === 'Tokens saved · 24h')!.value;
const label = `Llama Farm console: ${activeNodes.replace('/', ' of ')} nodes active, ${totalRequests} requests, ${tokensSaved} tokens saved.`;

// RequestVolumeLineChart.kt: 236 tall, paddings 36 / 40 / 12 / 26. x is in percent of the plot so it fits any width.
const PLOT_HEIGHT = 236 - 12 - 26;
const top = c.chart.yTicks[c.chart.yTicks.length - 1];
const series = ['desktop', 'ios', 'android'] as const;
const windows = c.chart.windows;
const xPct = (i: number) => (i / (windows.length - 1)) * 100;
const y = (v: number) => PLOT_HEIGHT - (PLOT_HEIGHT * v) / top;
const latest = windows[windows.length - 1];
// End labels nudged at least 14px apart, top to bottom.
let lastLabelY = -Infinity;
const ends = series
  .map((s) => ({ s, y: y(latest[s]), value: latest[s] }))
  .sort((a, b) => a.y - b.y)
  .map((end) => {
    const labelY = Math.max(end.y, lastLabelY + 14);
    lastLabelY = labelY;
    return { ...end, labelY };
  });
const seriesLabel = { desktop: 'Desktop', ios: 'iOS', android: 'Android' };
const filters = [
  { label: 'All', count: c.nodes.length, type: null },
  ...series.map((s) => ({ label: seriesLabel[s], count: c.nodes.filter((n) => n.type === s).length, type: s })),
];
---

<div class="shot console" role="img" aria-label={label}>
  <div class="window" aria-hidden="true">
    <div class="titlebar">
      <span class="lights"><i></i><i></i><i></i></span>
      <span class="titlebar__name">Llama Farm</span>
    </div>

    <header class="app-header">
      <div class="app-header__row">
        <span class="brand">
          <Lloyd mood="hello" size={32} eager />
          <span class="brand__name">Llama Farm</span>
        </span>
        <span class="farm-tag">{c.farmTag.toUpperCase()}</span>
        <span class="pills">
          <span class="pill pill--on">Console</span>
          <span class="pill">Node</span>
          <span class="pill">Settings</span>
        </span>
        <span class="spacer"></span>
        <span class="mcp">
          <span class="dot dot--halo"><i></i></span>
          <span class="mcp__label">MCP connected · {c.mcpAgents} agents</span>
        </span>
      </div>
    </header>

    <div class="page">
      <div class="title-row">
        <div class="summary">
          <p class="page-title">Agent nodes</p>
          <p class="t-body t-2">{c.subtitle}</p>
        </div>
        <div class="guide">
          <Lloyd mood="happy" size={96} eager />
          <LloydDialog text={c.lloyd} />
        </div>
      </div>

      <div class="tiles">
        {
          c.statTiles.map((tile) => (
            <div class="card tile">
              <span class="eyebrow">{tile.label.toUpperCase()}</span>
              <span class="tile__value">{tile.value}</span>
              <span class="tile__caption">{tile.caption}</span>
            </div>
          ))
        }
      </div>

      <div class="chart-row">
        <div class="card chart-card">
          <div class="card-head">
            <div>
              <p class="card-title">Requests, last 24 hours</p>
              <p class="t-small t-2">Per 3-hour window, by device type</p>
            </div>
            <div class="legend-row">
              <span class="legend">
                {
                  series.map((s) => (
                    <span class="legend__item">
                      <i class={`key key--${s}`} />
                      {seriesLabel[s]}
                    </span>
                  ))
                }
              </span>
              <span class="secondary-btn">Show table</span>
            </div>
          </div>
          <div class="chart">
            <svg class="plot" width="100%" height={PLOT_HEIGHT} overflow="visible">
              {
                c.chart.yTicks.map((tick) => (
                  <g>
                    <line class="grid" x1="0" x2="100%" y1={y(tick)} y2={y(tick)} />
                    <svg x="100%" overflow="visible">
                      <line class="grid" x1="0" x2="8" y1={y(tick)} y2={y(tick)} />
                    </svg>
                    <text class="axis" x="-8" y={y(tick)} text-anchor="end" dominant-baseline="central">
                      {tick}
                    </text>
                  </g>
                ))
              }
              {
                windows.map((w, i) => (
                  <text class="axis" x={`${xPct(i)}%`} y={PLOT_HEIGHT + 6} text-anchor="middle" dominant-baseline="hanging">
                    {w.label}
                  </text>
                ))
              }
              {
                series.map((s) =>
                  windows.slice(1).map((w, i) => (
                    <line
                      class={`series series--${s}`}
                      x1={`${xPct(i)}%`}
                      y1={y(windows[i][s])}
                      x2={`${xPct(i + 1)}%`}
                      y2={y(w[s])}
                    />
                  )),
                )
              }
              {
                ends.map((end) => (
                  <g>
                    <circle cx="100%" cy={end.y} r="6" fill="#fff" />
                    <circle cx="100%" cy={end.y} r="4" class={`fill--${end.s}`} />
                    <svg x="100%" overflow="visible">
                      <text class="end-label" x="10" y={end.labelY} dominant-baseline="central">
                        {end.value}
                      </text>
                    </svg>
                  </g>
                ))
              }
            </svg>
          </div>
        </div>

        <div class="card share-card">
          <div>
            <p class="card-title">Requests by device type</p>
            <p class="t-small t-2">Share of {totalRequests} requests in the last 24 hours</p>
          </div>
          <div class="share-bar">
            {c.share.map((s) => <i class={`bg--${s.type}`} style={`flex-grow:${s.count}`} />)}
          </div>
          <div class="share-legend">
            {
              c.share.map((s) => (
                <div class="share-legend__row">
                  <i class={`swatch bg--${s.type}`} />
                  <span class="t-body share-legend__name">{s.label}</span>
                  <span class="mono t-2">{s.count}</span>
                  <span class="mono share-legend__pct">{s.percent}%</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <div class="filters">
        {
          filters.map((f) => (
            <span class:list={['chip', { 'chip--on': f.type === null }]}>
              {f.type && <i class={`chip__dot bg--${f.type}`} />}
              {f.label} · {f.count}
            </span>
          ))
        }
      </div>

      <div class="card nodes-card">
        <div class="card-head">
          <p class="card-title">Nodes ({c.nodes.length})</p>
          <span class="search">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2">
              <circle cx="6.16" cy="6.16" r="4.48" />
              <path d="M9.52 9.52 13.3 13.3" />
            </svg>
            Search nodes…
          </span>
        </div>
        <div class="table-scroll">
          <div class="table">
            <div class="tr th">
              <span>NODE</span><span>STATUS</span><span>CAPABILITY</span><span class="r">BATTERY</span><span
                class="inset">POWER</span
              ><span class="r">REQ · 24H</span><span class="r">LATENCY</span><span class="r">UPTIME</span><span class="r"
                >LAST SEEN</span
              >
            </div>
            {
              c.nodes.map((n) => (
                <div class="tr">
                  <span class="node">
                    <i class={`node__swatch bg--${n.type}`} />
                    <span class="node__text">
                      <span class="node__name">{n.name}</span>
                      <span class="t-small t-2">{n.detail}</span>
                    </span>
                  </span>
                  <span>
                    <span class="status-pill">
                      <span class="dot">
                        <i />
                      </span>
                      Online
                    </span>
                  </span>
                  <span class="mono">{n.capability}</span>
                  <span class="mono r">{n.battery}</span>
                  <span class="inset">
                    {n.power ? (
                      <span class="status-pill">
                        <span class="dot">
                          <i />
                        </span>
                        {n.power}
                      </span>
                    ) : (
                      <span class="mono t-2">—</span>
                    )}
                  </span>
                  <span class="mono r">{n.requests}</span>
                  <span class="mono r">{n.latency}</span>
                  <span class="mono r">{n.uptime}</span>
                  <span class="mono r t-2">{n.lastSeen}</span>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .console {
    container-type: inline-size;
    color: var(--app-text);
    font-family: var(--font-sans);
    text-align: left;
  }

  .window {
    background: var(--app-bg);
    border: 1px solid var(--site-border-strong);
    border-bottom: 0;
    border-radius: 14px 14px 0 0;
    overflow: hidden;
  }

  /* On phones the reflowed console runs very long; crop it so its bottom edge bleeds into the next section. */
  @container (max-width: 700px) {
    .window {
      max-height: 860px;
    }
  }

  .titlebar {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 38px;
    background: var(--app-surface3);
    font: 600 13px/1 var(--font-sans);
    color: var(--app-text2);
  }

  .lights {
    position: absolute;
    left: 14px;
    display: flex;
    gap: 8px;
  }

  .lights i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .lights i:nth-child(2) {
    background: #febc2e;
  }

  .lights i:nth-child(3) {
    background: #28c840;
  }

  /* FarmAppHeader.kt */
  .app-header {
    background: var(--app-surface);
    border-bottom: 1px solid var(--app-border);
  }

  .app-header__row {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: calc(1240px + 56px);
    margin: 0 auto;
    padding: 12px 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 6px 0;
  }

  .brand__name {
    font-size: 17px;
    line-height: 22px;
    font-weight: 600;
    white-space: nowrap;
  }

  .farm-tag {
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--app-text2);
    border: 1px solid var(--app-border);
    border-radius: 4px;
    padding: 3px 6px;
    white-space: nowrap;
  }

  .pills {
    display: flex;
    gap: 4px;
  }

  .pill {
    display: flex;
    align-items: center;
    height: 36px;
    padding: 0 14px;
    border-radius: 18px;
    font-size: 14px;
    font-weight: 500;
    color: var(--app-text2);
  }

  .pill--on {
    background: var(--app-accent-soft);
    color: var(--app-accent-soft-fg);
    font-weight: 600;
  }

  .spacer {
    flex: 1;
  }

  .mcp {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 6px 8px;
    font-size: 13px;
    line-height: 18px;
    color: var(--app-text2);
    white-space: nowrap;
  }

  .dot {
    display: grid;
    place-items: center;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    flex: none;
  }

  .dot i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--app-green);
  }

  .dot--halo {
    background: var(--app-green-ring);
  }

  .brand__name,
  .farm-tag,
  .mcp__label {
    display: none;
  }

  @container (min-width: 560px) {
    .app-header__row {
      padding: 12px 28px;
    }

    .brand__name {
      display: inline;
    }
  }

  @container (min-width: 720px) {
    .mcp__label {
      display: inline;
    }
  }

  @container (min-width: 900px) {
    .farm-tag {
      display: inline;
    }
  }

  /* Page */
  .page {
    max-width: 1240px;
    margin: 0 auto;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .page-title {
    font-size: 30px;
    line-height: 36px;
    font-weight: 600;
  }

  .t-body {
    font-size: 14px;
    line-height: 20px;
  }

  .t-small {
    font-size: 13px;
    line-height: 18px;
  }

  .t-2 {
    color: var(--app-text2);
  }

  .mono {
    font: 400 13px/18px var(--font-mono);
  }

  .eyebrow {
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--app-text3);
  }

  .card {
    background: var(--app-surface);
    border: 1px solid var(--app-border);
    border-radius: 12px;
    padding: 16px 18px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    min-width: 0;
  }

  .card-title {
    font-size: 15px;
    line-height: 20px;
    font-weight: 600;
  }

  .card-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
  }

  /* ConsoleTitleRow.kt */
  .title-row {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .summary {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .guide {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .guide :global(.lloyd-dialog) {
    flex: 1;
  }

  @container (min-width: 956px) {
    .title-row {
      flex-direction: row;
      align-items: flex-start;
      gap: 32px;
    }

    .summary {
      flex: 1;
    }

    .guide {
      max-width: 460px;
    }
  }

  /* StatTileGrid.kt */
  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 12px;
  }

  .tile {
    gap: 6px;
  }

  .tile__value {
    font: 400 28px/1.2 var(--font-mono);
  }

  .tile__caption {
    font-size: 12px;
    line-height: 16px;
    color: var(--app-text2);
  }

  /* Chart + share row: side by side from 900 wide */
  .chart-row {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  @container (min-width: 956px) {
    .chart-row {
      flex-direction: row;
      align-items: flex-start;
    }

    .chart-card {
      flex: 2 1 0;
    }

    .share-card {
      flex: 1 1 0;
    }
  }

  .chart-card {
    gap: 10px;
  }

  .legend-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px;
  }

  .legend {
    display: flex;
    gap: 14px;
    font-size: 13px;
    line-height: 18px;
    color: var(--app-text2);
  }

  .legend__item {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .key {
    width: 14px;
    height: 3px;
    border-radius: 2px;
  }

  .key--desktop {
    background: var(--series-desktop);
  }

  .key--ios {
    background: var(--series-ios);
  }

  .key--android {
    background: var(--series-android);
  }

  .secondary-btn {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--app-border-strong);
    border-radius: 8px;
    background: var(--app-surface);
    font-size: 14px;
    font-weight: 500;
  }

  .chart {
    height: 236px;
    padding: 12px 40px 26px 36px;
  }

  .plot {
    display: block;
    overflow: visible;
  }

  .grid {
    stroke: var(--app-grid);
    stroke-width: 1;
  }

  .axis {
    font: 400 11px var(--font-mono);
    fill: var(--app-text3);
  }

  .end-label {
    font: 400 12px var(--font-mono);
    fill: var(--app-text);
  }

  .series {
    stroke-width: 2;
    stroke-linecap: round;
  }

  .series--desktop {
    stroke: var(--series-desktop);
  }

  .series--ios {
    stroke: var(--series-ios);
  }

  .series--android {
    stroke: var(--series-android);
  }

  .fill--desktop {
    fill: var(--series-desktop);
  }

  .fill--ios {
    fill: var(--series-ios);
  }

  .fill--android {
    fill: var(--series-android);
  }

  .bg--desktop {
    background: var(--series-desktop);
  }

  .bg--ios {
    background: var(--series-ios);
  }

  .bg--android {
    background: var(--series-android);
  }

  /* DeviceShareBar.kt */
  .share-card {
    gap: 16px;
  }

  .share-bar {
    display: flex;
    gap: 2px;
    height: 24px;
  }

  .share-bar i {
    flex-basis: 0;
  }

  .share-bar i:first-child {
    border-radius: 4px 0 0 4px;
  }

  .share-bar i:last-child {
    border-radius: 0 4px 4px 0;
  }

  .share-legend {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .share-legend__row {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .swatch {
    width: 12px;
    height: 12px;
    border-radius: 3px;
    flex: none;
  }

  .share-legend__name {
    flex: 1;
  }

  .share-legend__pct {
    padding-left: 4px;
  }

  /* DeviceFilterRow.kt */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    border: 1px solid var(--app-border-strong);
    background: var(--app-surface);
    font-size: 14px;
    font-weight: 500;
  }

  .chip--on {
    background: var(--app-accent);
    border-color: var(--app-accent);
    color: #fff;
  }

  .chip__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  /* NodeTable.kt */
  .search {
    display: flex;
    align-items: center;
    gap: 8px;
    width: 240px;
    min-height: 40px;
    padding: 0 10px;
    background: var(--app-surface2);
    border: 1px solid var(--app-border-strong);
    border-radius: 8px;
    font-size: 14px;
    line-height: 20px;
    color: var(--app-text3);
  }

  .table-scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  .table {
    min-width: 960px;
  }

  .tr {
    display: grid;
    grid-template-columns: 2.4fr 1.6fr 1.4fr 0.8fr 1.3fr 0.9fr 0.9fr 0.9fr 0.9fr;
    gap: 12px;
    align-items: center;
    padding: 10px 0;
    border-top: 1px solid var(--app-rule);
  }

  .th {
    padding: 8px 0;
    border-top: 0;
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--app-text3);
  }

  .r {
    text-align: right;
  }

  .inset {
    padding-left: 16px;
  }

  .node {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .node__swatch {
    width: 10px;
    height: 10px;
    border-radius: 3px;
    flex: none;
  }

  .node__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    white-space: nowrap;
  }

  .node__name {
    font-size: 14px;
    font-weight: 500;
    line-height: 20px;
  }

  .status-pill {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 10px 3px 6px;
    border-radius: 999px;
    background: var(--app-accent-soft);
    color: var(--app-accent-soft-fg);
    font-size: 13px;
    line-height: 18px;
  }
</style>
