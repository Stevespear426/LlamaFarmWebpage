---
// The 1200×630 share card. scripts/render-images.mjs screenshots it into public/og.png;
// it isn't linked from the site or listed in the sitemap.
import Base from '../layouts/Base.astro';
import Lloyd from '../components/Lloyd.astro';
import LloydDialog from '../components/LloydDialog.astro';
import data from '../data/sample.json';
import { SITE } from '../config';

const s = data.social;
const displayDomain = SITE.domain.replace(/^https?:\/\//, '');
---

<Base title="Llama Farm share card" noindex>
  <div class="social dot-grid">
    <div class="social__left">
      <span class="brand"><Lloyd mood="hello" size={64} eager />Llama Farm</span>
      <h1 class="h1 social__title">Put the herd to work<br /><span class="accent">for your AI agents.</span></h1>
      <p class="social__line">The devices you already own, as extra compute for Claude Code, Codex and Gemini CLI.</p>
      {!displayDomain.includes('[') && <p class="caption social__domain">{displayDomain}</p>}
    </div>
    <div class="social__card">
      <div class="guide">
        <Lloyd mood="happy" size={64} eager />
        <LloydDialog text={s.lloyd} />
      </div>
      <div class="tile tile--big">
        <span class="eyebrow">TOKENS SAVED · 24H</span>
        <span class="value value--big">{s.tokensSaved}</span>
        <span class="tile__caption">{s.tokensCaption}</span>
      </div>
      <div class="pair">
        <div class="tile">
          <span class="eyebrow">ACTIVE NODES</span>
          <span class="value">{s.activeNodes}</span>
        </div>
        <div class="tile">
          <span class="eyebrow">AVG LATENCY</span>
          <span class="value">{s.avgLatency}</span>
        </div>
      </div>
    </div>
  </div>
</Base>

<style>
  .social {
    width: 1200px;
    height: 630px;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 56px 56px 56px 64px;
    overflow: hidden;
  }

  .social__left {
    flex: 1;
    display: grid;
    gap: 24px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 16px;
    font-size: 28px;
    font-weight: 600;
    color: var(--site-heading);
  }

  .social__title {
    font-size: 68px;
    white-space: nowrap;
  }

  .social__line {
    font-size: 22px;
    line-height: 1.45;
    color: var(--site-text-2);
    max-width: 560px;
  }

  .social__domain {
    font-size: 16px;
  }

  .social__card {
    width: 400px;
    flex: none;
    display: grid;
    gap: 12px;
    padding: 22px;
    border-radius: 16px;
    background: var(--app-bg);
    color: var(--app-text);
  }

  .guide {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .guide :global(.lloyd-dialog) {
    flex: 1;
  }

  .tile {
    display: grid;
    gap: 4px;
    padding: 14px 16px;
    border-radius: 12px;
    border: 1px solid var(--app-border);
    background: var(--app-surface);
  }

  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  .eyebrow {
    font: 500 11px/1.3 var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--app-text3);
  }

  .value {
    font: 400 26px/1.2 var(--font-mono);
  }

  .value--big {
    font-size: 44px;
  }

  .tile__caption {
    font-size: 13px;
    color: var(--app-text2);
  }
</style>
